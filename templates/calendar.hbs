<section class="opath-body">
  <header class="opath-header"><div><h2>{{currentLabel}}</h2><p class="opath-muted">{{currentTime}} · {{current.season}} · {{branchName}}</p></div></header>
  <nav class="opath-tabs" aria-label="Abas"><button type="button" data-action-local="calendar" {{#if calendarTab}}aria-current="page"{{/if}}>Calendário</button><button type="button" data-action-local="journal" {{#if journalTab}}aria-current="page"{{/if}}>Meu diário</button><button type="button" data-action-local="clock" {{#if clockTab}}aria-current="page"{{/if}}>Relógio e iluminação</button>{{#if newspaperActive}}<button type="button" data-action-local="newspaper">Jornal da Queda</button>{{/if}}</nav>
  {{#if calendarTab}}
    <nav class="opath-toolbar"><button type="button" data-action-local="previous" aria-label="Anel anterior">‹</button><form data-year-form><label>Anel<input name="viewYear" type="number" step="1" value="{{viewYear}}" required></label><button type="submit">Ver</button></form><button type="button" data-action-local="next" aria-label="Próximo Anel">›</button><button type="button" data-action-local="today">Hoje</button>
      {{#if isGM}}<select name="mode" aria-label="Contagem"><option value="lunar" {{lunarSelected}}>Lunar · 240 dias</option><option value="solar" {{solarSelected}}>Solar · 480 dias</option></select><select name="branch" aria-label="Linha do tempo">{{#each branches}}<option value="{{id}}" {{selected}}>{{name}}</option>{{/each}}</select>{{/if}}
    </nav>
    <details class="opath-filter-details" data-filter-details {{#if filtersOpen}}open{{/if}}><summary>Filtrar registros{{#if hasFilters}} · filtros ativos{{/if}}</summary><div class="opath-filters"><label>Localidade<input data-filter="location" value="{{filters.location}}" placeholder="Todas as localidades"></label><label>Clima<input data-filter="weather" value="{{filters.weather}}" placeholder="Todos os climas"></label><label>Autor<select data-filter="author"><option value="">Todos</option>{{#each authors}}<option value="{{id}}" {{selected}}>{{name}}</option>{{/each}}</select></label><button type="button" data-action-local="clear-filters">Limpar</button></div></details>
    <div class="opath-layout"><div class="opath-year">
      {{#each cycles}}<article class="opath-cycle"><h3>{{name}}</h3><div class="opath-days">{{#each ../weekdays}}<abbr title="{{name}}">{{abbreviation}}</abbr>{{/each}}
        {{#each days}}<button type="button" class="opath-day {{#if current}}is-today{{/if}} {{#if selected}}is-selected{{/if}} {{#if festival}}is-festival{{/if}}" data-day="{{absoluteDay}}" title="{{title}}" aria-label="Dia {{day}} {{title}}" aria-pressed="{{selected}}"><span class="opath-moon-pair">{{#each moons}}<svg class="opath-moon-icon" style="color:{{color}}" viewBox="0 0 24 24" role="img" aria-label="{{name}}: {{phase}}"><title>{{name}}: {{phase}}</title><use href="modules/quedaco-calendario/assets/moons.svg#{{icon}}"></use></svg>{{/each}}</span><span class="opath-day-number">{{day}}</span>{{#if notes}}<span class="opath-paper {{#if publicNotes}}is-public{{/if}}" title="Há anotações neste dia">📄</span>{{/if}}</button>{{/each}}
      </div></article>{{/each}}
    </div>
    <aside class="opath-details"><h3>{{selectedLabel}}</h3><p>{{selected.season}} · Dia {{selected.dayOfYear}} de {{selected.yearDays}}</p>
      <div class="opath-moon-details">{{#each moons}}<p><svg class="opath-moon-icon" style="color:{{color}}" viewBox="0 0 24 24" role="img" aria-label="{{name}}: {{phase}}"><title>{{name}}: {{phase}}</title><use href="modules/quedaco-calendario/assets/moons.svg#{{icon}}"></use></svg><span style="color:{{color}}">{{name}}</span> · {{phase}}</p>{{/each}}</div>
      <div class="opath-buttons"><button type="button" data-action-local="new">Escrever neste dia</button>{{#if isGM}}<button type="button" data-action-local="current">Definir como dia atual</button>{{/if}}</div>
      {{#if holidays}}<h4>Feriados</h4>{{#each holidays}}<button type="button" class="opath-title-link opath-holiday-title" data-holiday="{{@index}}">{{name}}</button>{{/each}}{{/if}}
      {{#if events}}<h4>Anotações do dia</h4><button type="button" data-action-local="all">Abrir todas as anotações do dia</button>{{/if}}
      {{#each events}}<article class="opath-event"><button type="button" class="opath-title-link" data-open="{{uuid}}">{{title}}</button><p>{{authorName}} · {{visibilityLabel}}</p>{{#if location}}<p>📍 {{location}} · {{weather}}</p>{{/if}}{{#if canEdit}}<div class="opath-buttons"><button type="button" data-edit="{{uuid}}">Editar / compartilhar</button><button type="button" data-archive="{{uuid}}">Lixeira</button></div>{{/if}}</article>{{else}}<p class="opath-muted">Sem anotações visíveis.</p>{{/each}}
      {{#if isGM}}<details class="opath-advanced"><summary>Histórico e viagem no tempo</summary>{{#each history}}<article class="opath-event"><button type="button" class="opath-title-link" data-open="{{uuid}}">{{title}}</button><p class="opath-muted">Anel conhecido; dia e Ciclo não informados.</p></article>{{/each}}<button type="button" data-action-local="history">Importar históricos do livro</button>
        <form data-date-form class="opath-form"><h4>Data e viagem no tempo</h4><label>Anel (negativo para A.F.)<input type="number" step="1" name="year" required value="{{selected.year}}"></label><label>Ciclo<select name="cycle">{{#each cycleOptions}}<option value="{{value}}" {{selected}}>{{label}}</option>{{/each}}</select></label><label>Dia<input type="number" min="1" max="15" step="1" name="day" required value="{{selected.day}}"></label><label>Hora<input type="time" name="time" step="1" required value="{{currentTime}}"></label><button type="submit" value="move">Definir data e hora atuais</button><button type="submit" value="calibrate">Calibrar sem alterar a hora</button><label>Nome da missão secundária<input name="branchName" maxlength="100" placeholder="Missão no passado"></label><button type="submit" value="branch">Criar missão nesta data e entrar</button><p class="opath-muted">Ao trocar de missão, a data atual é guardada. Selecione “Campanha principal” para retomar de onde parou. Os registros ficam separados por linha do tempo.</p></form>
      </details>{{/if}}
    </aside></div>
  {{/if}}
  {{#if clockTab}}<section class="opath-clock-settings"><h3>Relógio da campanha · {{currentTime}}</h3><p>Controlador: {{#if nativeClock}}QUEDAÇO nativo{{else}}{{#if clockOff}}desativado{{else}}SmallTime (compatibilidade){{/if}}{{/if}}</p>
    {{#if isGM}}<form data-time-form class="opath-inline-form"><label>Horário<input type="time" name="time" value="{{currentTime}}" required></label><button type="submit">Definir horário</button></form><div class="opath-time-controls"><button type="button" data-advance="-86400">−1 dia</button><button type="button" data-advance="-3600">−1 hora</button><button type="button" data-advance="3600">+1 hora</button><button type="button" data-advance="86400">+1 dia</button></div>
    <label>Controle de iluminação<select data-clock-mode><option value="auto">Automático — nativo sem SmallTime</option><option value="native">Nativo — desative SmallTime</option><option value="off">Desativado no Calendário</option></select></label>
    {{#if smalltime.active}}<p class="opath-muted">SmallTime está ativo e mantém a prioridade. Desative-o em Gerenciar módulos para testar o painel nativo. Nenhuma configuração dele será apagada.</p>{{/if}}
    <h3>Iluminação da cena ativa · {{lighting.sceneName}}</h3><p>{{#if darkLinked}}Vinculada ao horário{{else}}Iluminação automática desligada{{/if}}{{#if lighting.locked}} · bloqueada pela cena{{/if}}</p>
    {{#if nativeClock}}<button type="button" data-action-local="darkness">{{#if darkLinked}}Desligar{{else}}Ligar{{/if}} iluminação nesta cena</button>{{/if}}
    <form data-light-form class="opath-form opath-light-form"><h4>Amanhecer, anoitecer e escuridão</h4><p class="opath-muted">Horários em horas (6,5 = 06:30). Escuridão: 0 = claro; 1 = escuro. Apenas cenas vinculadas são alteradas.</p><div class="opath-light-grid"><label>Início do amanhecer<input name="sunriseStart" type="number" step="0.25" min="0" max="24" value="{{lighting.config.sunriseStart}}" required></label><label>Fim do amanhecer<input name="sunriseEnd" type="number" step="0.25" min="0" max="24" value="{{lighting.config.sunriseEnd}}" required></label><label>Início do anoitecer<input name="sunsetStart" type="number" step="0.25" min="0" max="24" value="{{lighting.config.sunsetStart}}" required></label><label>Fim do anoitecer<input name="sunsetEnd" type="number" step="0.25" min="0" max="24" value="{{lighting.config.sunsetEnd}}" required></label><label>Escuridão de dia<input name="minDarkness" type="number" step="0.05" min="0" max="1" value="{{lighting.config.minDarkness}}" required></label><label>Escuridão à noite<input name="maxDarkness" type="number" step="0.05" min="0" max="1" value="{{lighting.config.maxDarkness}}" required></label></div><button type="submit">Salvar iluminação nativa</button></form>
    {{else}}<p class="opath-muted">Somente a Mestra altera o horário e a iluminação.</p>{{/if}}
    <p class="opath-muted">No painel compacto, arraste o sol/lua para mudar a hora. Use ⠿ para mover o painel ou ↺ para voltar à posição automática. A visibilidade do painel pode ser alterada nas configurações do módulo.</p>
  </section>{{/if}}
  {{#if journalTab}}
    <div class="opath-journal-toolbar"><button type="button" data-action-local="calendar">← Voltar ao calendário</button><button type="button" data-action-local="new">Novo registro na data selecionada</button><button type="button" data-action-local="trash">{{#if trash}}Sair da lixeira{{else}}Lixeira / restaurar{{/if}}</button></div>
    <div class="opath-journal-layout"><aside class="opath-record-list"><h3>{{#if trash}}Lixeira recuperável{{else}}Meus registros{{/if}}</h3>{{#each ownRecords}}<article class="opath-event"><button type="button" data-open="{{uuid}}" class="opath-title-link">{{title}}</button><p>{{dateLabel}} · {{location}}</p>{{#if ../trash}}<button type="button" data-restore="{{uuid}}">Restaurar</button>{{else}}<button type="button" data-edit="{{uuid}}">Editar</button>{{/if}}</article>{{else}}<p class="opath-muted">Nenhum registro.</p>{{/each}}</aside>
    <div class="opath-editor">{{#if canEditDraft}}<form data-record-form class="opath-form"><h3>{{draftDate}}</h3><p class="opath-muted">A anotação é desta data. Escrever no diário não altera a data da campanha.</p>
      <label>Título<input name="title" required maxlength="160" value="{{draft.title}}"></label><label>Localidade<input name="location" list="opath-locations" maxlength="200" value="{{draft.location}}" placeholder="Onde vocês estavam?"></label><datalist id="opath-locations">{{#each locations}}<option value="{{this}}">{{/each}}</datalist>
      <label>Clima do dia<input name="weather" list="opath-weathers" maxlength="200" value="{{draft.weather}}" placeholder="Como estava o tempo?"></label><datalist id="opath-weathers">{{#each weathers}}<option value="{{this}}">{{/each}}</datalist>
      <label>Texto do diário<textarea name="description" rows="10" maxlength="20000">{{draft.description}}</textarea></label>
      <label>Imagem<input name="image" value="{{draft.image}}" placeholder="Caminho ou URL https"></label><button type="button" data-action-local="image">Escolher imagem</button>
      <label>Visibilidade<select name="visibility"><option value="private" {{privateSelected}}>Só eu e a Mestra</option>{{#unless draft.historicalKey}}<option value="shared" {{sharedSelected}}>Jogadores escolhidos</option><option value="public" {{publicSelected}}>Todos os jogadores</option>{{/unless}}</select></label>
      <fieldset><legend>Compartilhar com (na opção “Jogadores escolhidos”)</legend>{{#each players}}<label class="opath-checkbox"><input type="checkbox" name="sharedWith" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{/each}}</fieldset>
      <label>Repetição<select name="repeat"><option value="once" {{repeatOnce}}>Somente esta data</option><option value="lunar" {{repeatLunar}}>A cada 240 dias</option><option value="solar" {{repeatSolar}}>A cada 480 dias</option></select></label>
      <h4>Anexos e referências</h4><p class="opath-muted">Arraste um Journal, página ou Item para este editor. Os links respeitam as permissões originais.</p>
      {{#each draft.links}}<div class="opath-attached"><span>{{label}}</span><button type="button" data-remove-link="{{uuid}}">Remover referência</button></div>{{/each}}
      {{#if newspaperActive}}<label>Edição do Jornal da Queda<select data-newspaper-select><option value="">Escolher edição já acessível</option>{{#each newspapers}}<option value="{{uuid}}">{{label}}</option>{{/each}}</select></label>{{/if}}
      <button type="submit">Salvar registro e visibilidade</button><p class="opath-muted">Para despublicar, escolha “Só eu e a Mestra” e salve. A Mestra deve estar conectada para atualizar o compartilhamento.</p>
    </form><form data-uuid-form class="opath-form"><label>UUID de um Journal ou Item<input name="uuid" required placeholder="JournalEntry.…"></label><button type="submit">Anexar referência</button></form>
    {{else}}<p>Selecione um registro para editar ou escreva uma nova anotação na data escolhida.</p>{{/if}}</div></div>
  {{/if}}
  {{#if readerTab}}<button type="button" data-action-local="calendar">← Voltar ao calendário</button><h3>{{selectedLabel}} · Edição do dia</h3><div class="opath-day-edition">{{#each reader}}<article class="opath-read-record"><h3>{{title}}</h3>{{#if location}}<p>📍 {{location}} · {{weather}}</p>{{/if}}<p class="opath-reader-text">{{description}}</p>{{#if image}}<img src="{{image}}" alt="Imagem da anotação">{{/if}}{{#each links}}<button type="button" data-open="{{uuid}}">{{label}}</button>{{/each}}</article>{{else}}<p>Nenhuma anotação acessível neste dia.</p>{{/each}}</div>{{/if}}
  <footer class="opath-muted">Registros individuais no Journal · papel = anotações visíveis · só a Mestra altera a data · estações de 120 dias.</footer>
</section>
